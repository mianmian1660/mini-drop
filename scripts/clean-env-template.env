# ==============================================================================
# clean-env-template.env — 两日存储模型干净切换后的 .env 配置模板
# ==============================================================================
# 用途：服务器执行 scripts/server-storage-reset-v2.sh execute 之后，把本模板
# 写入 /home/ubuntu/mini-drop/.env（覆盖旧值），再按顺序启动服务：
#   cp scripts/clean-env-template.env /home/ubuntu/mini-drop/.env
#   docker compose up -d postgres minio minio-init
#   docker compose up -d drop_server apiserver analysis drop_agent web_frontend
#
# 说明（见《Mini-Drop 两日存储模型干净切换计划》）：
#   - Parquet 从新数据开始直接 enforce，不再生成长期 v1 小时块。
#   - Fine-row GC 第一天保持 observe，完成 24 小时验证后再切 enforce。
#   - Blob 历史迁移关闭；新 CAS 存储继续工作，GC 负责孤儿 Blob。
#   - 根盘少于 8GiB 时停止新采集。
# ==============================================================================

# --- Artifact 生命周期（enforce）---
ARTIFACT_LIFECYCLE_MODE=enforce
ARTIFACT_RAW_LARGE_HOURS=24
ARTIFACT_RAW_PORTABLE_HOURS=168
ARTIFACT_INTERMEDIATE_HOURS=24
ARTIFACT_DIAGNOSTIC_HOURS=72
ARTIFACT_RESULT_RETENTION_HOURS=720
ARTIFACT_SUPERSEDED_RESULT_HOURS=72
ARTIFACT_NOT_BEFORE_PROTECTION_HOURS=24

# --- 单次采样最终存储模型 ---
SINGLE_SHOT_LAYOUT_V2_ENABLED=true
ANALYSIS_GENERATIONS_ENABLED=true
ANALYSIS_REANALYZE_ENABLED=true
PORTABLE_PROFILE_MODE=enforce

# --- Blob（历史迁移关闭，GC 开启）---
BLOB_BACKFILL_ENABLED=false
BLOB_MIGRATION_ENABLED=false
BLOB_GC_ENABLED=true

# --- Continuous Parquet v2（enforce）+ receipt GC ---
CONTINUOUS_PARQUET_MODE=enforce
CONTINUOUS_FINE_ROW_GC_MODE=observe
CONTINUOUS_HOT_METADATA_RETENTION_MINUTES=120
CONTINUOUS_STAGING_MINUTES_RETENTION=120
CONTINUOUS_PARQUET_RAW_RETENTION_HOURS=24
CONTINUOUS_PARQUET_5M_RETENTION_HOURS=168
CONTINUOUS_PARQUET_1H_RETENTION_HOURS=720
CONTINUOUS_MIGRATION_RECEIPT_RETENTION_HOURS=72

# --- Continuous 硬配额（1 GiB / 目标 768 MiB）---
CONTINUOUS_QUOTA_BYTES=1073741824
CONTINUOUS_QUOTA_TARGET_BYTES=805306368

# --- 根盘压力阈值 ---
STORAGE_WARNING_FREE_BYTES=2147483648
STORAGE_CRITICAL_FREE_BYTES=1073741824
STORAGE_MIN_FREE_BYTES=536870912
CONTINUOUS_PARQUET_RECOVER_HYSTERESIS_BYTES=134217728

# --- Agent spool 与 Go 符号缓存上限 ---
DROP_NATIVE_CP_SPOOL_MAX_BYTES=536870912
DROP_NATIVE_CP_SPOOL_MIN_FREE_BYTES=8589934592
DROP_GO_SYMBOL_CACHE_MAX_BYTES=268435456
